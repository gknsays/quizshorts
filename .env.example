# --- Gemini (soru uretimi + dogrulama) ---
# aistudio.google.com/apikey adresinden ucretsiz alinir
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Seslendirme (Microsoft Edge TTS - anahtar gerekmez) ---
EDGE_TTS_VOICE=tr-TR-AhmetNeural
EDGE_TTS_RATE=+8%

# --- YouTube yukleme ---
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REDIRECT_URI=http://localhost:8765/oauth2callback
# public | unlisted | private
YT_PRIVACY_STATUS=public

# --- Kanal kimligi (kapanis ekraninda gosteriliyor) ---
CHANNEL_NAME=Fokus
